{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/live-ws.ts": {
      "maxDuration": 60
    },
    "api/chat.ts": {
      "maxDuration": 30
    },
    "api/status.ts": {
      "maxDuration": 15
    }
  }
}
